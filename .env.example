# ==============================================================================
# MBA Full Cycle - Knowledge Extractor Configuration
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto ou dentro de tools/knowledge-extractor/
# Exemplo: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Provedor de Síntese de Aulas (Estratégia Híbrida: Local-First com Fallback Cloud)
# ------------------------------------------------------------------------------
# Opções para SYNTHESIS_PROVIDER:
#   - "auto"    : Tenta o SLM Local (Ollama) primeiro; se falhar ou indisponível, usa Gemini Cloud (Recomendado)
#   - "ollama"  : Usa exclusivamente o SLM Local via Ollama
#   - "gemini"  : Usa exclusivamente a API do Gemini Cloud
SYNTHESIS_PROVIDER=auto

# ------------------------------------------------------------------------------
# 2. Configurações do SLM Local (Ollama)
# ------------------------------------------------------------------------------
# URL base do servidor Ollama local
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# GUIA DE MODELOS LOCAIS RECOMENDADOS (Rankeados para Síntese Técnica Longa):
# ------------------------------------------------------------------------------
# Como o objetivo é processar transcrições de 30k a 50k caracteres (~8k a 12k tokens)
# e gerar apostilas exaustivas (com código e Mermaid), estes são os modelos ideais
# compatíveis com o seu hardware (32 GB RAM):
#
# 1. "qwen2.5:7b-instruct" (OU "qwen2.5:14b-instruct") [ALTAMENTE RECOMENDADO]
#    - Comando para baixar: ollama pull qwen2.5:7b-instruct
#    - Por que: É atualmente o SLM estado da arte em aderência a instruções longas,
#      geração de sintaxe Mermaid válida, excelente vocabulário técnico em PT-BR
#      e suporte nativo a até 128k tokens de contexto.
#
# 2. "llama3.1:8b" [JÁ DISPONÍVEL NO SEU SISTEMA]
#    - Por que: Contexto de 128k tokens, raciocínio lógico afiado. Precisa do
#      prompt detalhado (já embutido) para evitar resumos muito telegráficos.
#
# 3. "qwen2.5-coder:7b-instruct" (OU "qwen2.5-coder:14b-instruct")
#    - Comando para baixar: ollama pull qwen2.5-coder:7b-instruct
#    - Por que: Especializado em engenharia de software, ideal para disciplinas com
#      muito live-coding (Labs, TypeScript, Python, Nest, LangGraph).
#
# 4. "mistral-nemo:12b"
#    - Comando para baixar: ollama pull mistral-nemo
#    - Por que: Janela de 128k tokens, parceria Mistral + NVIDIA. Excelente em
#      estruturação de markdown técnico e português fluente.
#
# 5. "deepseek-r1:8b" (Raciocínio / CoT)
#    - Comando para baixar: ollama pull deepseek-r1:8b
#    - Por que: Excelente para dissecar decisões de arquitetura e trade-offs complexos,
#      embora seja um pouco mais lento por gerar cadeia de pensamento (<think>).
# ------------------------------------------------------------------------------
OLLAMA_MODEL=qwen2.5:7b-instruct

# Tamanho da janela de contexto para o Ollama (em tokens).
# 32768 tokens é ideal para processar aulas de 40 a 60 minutos (30k-50k caracteres) sem truncamento
OLLAMA_NUM_CTX=32768

# Timeout em segundos para inferência do modelo local. Em CPU (sem GPU) uma aula leva 6-30 min,
# por isso 1800 (30 min). Se estourar, o modo "auto" cai para o Gemini.
OLLAMA_TIMEOUT_SECONDS=1800

# ------------------------------------------------------------------------------
# 3. Configurações do Google Gemini (Fallback ou Cloud Principal)
# ------------------------------------------------------------------------------
# Obtenha sua API Key gratuita no Google AI Studio: https://aistudio.google.com/
# No plano Free Tier, você tem 1 milhão de tokens de contexto a custo zero.
GEMINI_API_KEY=sua_gemini_api_key_aqui

# Modelo Gemini recomendado (Rápido, 1M contexto, alta precisão):
# Opções: "gemini-2.5-flash", "gemini-2.0-flash", "gemini-1.5-flash"
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Configurações de Transcrição de Áudio (faster-whisper)
# ------------------------------------------------------------------------------
# Modelo do Whisper para transcrição local: "tiny", "base", "small", "medium", "large-v3"
# "base" é rápido e consome pouca memória; "medium" ou "large-v3" têm maior fidelidade
WHISPER_MODEL_SIZE=base

# Dispositivo de processamento: "auto", "cpu", "cuda"
WHISPER_DEVICE=auto

# Tipo de computação: "int8", "float16", "float32"
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------------------------
# 5. Métricas de Processamento
# ------------------------------------------------------------------------------
# CSV com início/fim/duração de cada atividade (padrão: tools/knowledge-extractor/logs/pipeline-metrics.csv)
# METRICS_LOG=tools/knowledge-extractor/logs/pipeline-metrics.csv
