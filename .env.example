# ==============================================================================
# MBA Full Cycle - Knowledge Extractor Configuration
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto ou dentro de tools/knowledge-extractor/
# Exemplo: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Provedor de Síntese de Aulas (Cascata Resiliente de 3 Níveis)
# ------------------------------------------------------------------------------
# Opções para SYNTHESIS_PROVIDER:
#   - "auto"     : 1º Gemini Cloud → 2º DeepSeek-V3 Cloud → 3º Ollama Local → Scaffold (Recomendado)
#   - "gemini"   : Usa exclusivamente o Gemini Cloud
#   - "deepseek" : Usa exclusivamente o DeepSeek-V3 Cloud (ou endpoint OpenAI-compatible)
#   - "ollama"   : Usa exclusivamente o SLM Local via Ollama
SYNTHESIS_PROVIDER=auto

# ------------------------------------------------------------------------------
# 2. Tier 1: Configurações do Google Gemini (Cloud Principal)
# ------------------------------------------------------------------------------
# Obtenha sua API Key no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=sua_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 3. Tier 2: Configurações do DeepSeek-V3 / OpenRouter (Fallback Cloud Ilimitado)
# ------------------------------------------------------------------------------
# Quando o Gemini atingir cota (429) ou estiver indisponível, o pipeline aciona
# automaticamente o DeepSeek-V3 para síntese sem interrupção.
# Aceita tanto chave oficial da DeepSeek quanto OpenRouter ou 9Router local.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Caso use OpenRouter para o DeepSeek:
# OPENROUTER_API_KEY=sk-or-v1-...
# DEEPSEEK_MODEL=deepseek/deepseek-chat
# DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 4. Tier 3: Configurações do SLM Local (Ollama - Terceira Opção Offline)
# ------------------------------------------------------------------------------
# URL base do servidor Ollama local
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------------------
# GUIA DE MODELOS LOCAIS RECOMENDADOS (Rankeados para Síntese Técnica Longa):
# ------------------------------------------------------------------------------
# Como o objetivo é processar transcrições de 30k a 50k caracteres (~8k a 12k tokens)
# e gerar apostilas exaustivas (com código e Mermaid), estes são os modelos ideais
# compatíveis com o seu hardware (32 GB RAM):
#
# 1. "qwen2.5:7b-instruct" (OU "qwen2.5:14b-instruct") [ALTAMENTE RECOMENDADO]
#    - Comando para baixar: ollama pull qwen2.5:7b-instruct
#    - Por que: É atualmente o SLM estado da arte em aderência a instruções longas,
#      geração de sintaxe Mermaid válida, excelente vocabulário técnico em PT-BR
#      e suporte nativo a até 128k tokens de contexto.
#
# 2. "llama3.1:8b" [JÁ DISPONÍVEL NO SEU SISTEMA]
#    - Por que: Contexto de 128k tokens, raciocínio lógico afiado. Precisa do
#      prompt detalhado (já embutido) para evitar resumos muito telegráficos.
#
# 3. "qwen2.5-coder:7b-instruct" (OU "qwen2.5-coder:14b-instruct")
#    - Comando para baixar: ollama pull qwen2.5-coder:7b-instruct
#    - Por que: Especializado em engenharia de software, ideal para disciplinas com
#      muito live-coding (Labs, TypeScript, Python, Nest, LangGraph).
#
# 4. "mistral-nemo:12b"
#    - Comando para baixar: ollama pull mistral-nemo
#    - Por que: Janela de 128k tokens, parceria Mistral + NVIDIA. Excelente em
#      estruturação de markdown técnico e português fluente.
#
# 5. "deepseek-r1:8b" (Raciocínio / CoT)
#    - Comando para baixar: ollama pull deepseek-r1:8b
#    - Por que: Excelente para dissecar decisões de arquitetura e trade-offs complexos,
#      embora seja um pouco mais lento por gerar cadeia de pensamento (<think>).
# ------------------------------------------------------------------------------
OLLAMA_MODEL=qwen2.5:7b-instruct

# Tamanho da janela de contexto para o Ollama (em tokens).
# 32768 tokens é ideal para processar aulas de 40 a 60 minutos (30k-50k caracteres) sem truncamento
OLLAMA_NUM_CTX=32768

# Timeout em segundos para inferência do modelo local. Em CPU (sem GPU) uma aula leva 6-30 min,
# por isso 1800 (30 min). Se estourar, o modo "auto" cai para o Gemini.
OLLAMA_TIMEOUT_SECONDS=1800

# ------------------------------------------------------------------------------
# 3. Configurações do Google Gemini (Fallback ou Cloud Principal)
# ------------------------------------------------------------------------------
# Obtenha sua API Key gratuita no Google AI Studio: https://aistudio.google.com/
# No plano Free Tier, você tem 1 milhão de tokens de contexto a custo zero.
GEMINI_API_KEY=sua_gemini_api_key_aqui

# Modelo Gemini recomendado (Rápido, 1M contexto, alta precisão):
# Modelo usado na curadoria de figuras. A síntese usa SYNTH_MODELS (seção 3b).
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3b. Rodízio ponderado de modelos de síntese (LRT-07)
# ------------------------------------------------------------------------------
# Formato: provedor:id-do-modelo[:peso][;flag], separados por vírgula.
#   provedor = 1º campo (gemini | openrouter); peso = último campo inteiro (padrão 1).
#   O id pode conter ':' (ex.: modelo:free). Se o id terminar em ':<número>', informe o peso.
#   Peso 0 = só como último recurso. Ordem sorteada a cada chamada, proporcional ao peso.
#   Flags: ;allow_training (OpenRouter: aceita endpoints que coletam dados p/ treino —
#   por padrão TODOS vão com data_collection=deny), ;text (modelo sem visão).
# SYNTH_MODELS = multimodais (únicos usados em aulas com frames ou PDF com figuras).
SYNTH_MODELS=gemini:gemini-2.5-flash:45,openrouter:z-ai/glm-5.3-flash:25,openrouter:nvidia/nemotron-3.5-super-vl:free:20;allow_training,gemini:gemini-3.5-flash-lite:5,openrouter:dots-studio/dots-3-note-preview:free:5,openrouter:google/gemma-4-31b-it:free:0
# Modelos só de texto, usados apenas quando não há imagens (ex.: PDF sem figuras).
# Ex.: SYNTH_TEXT_MODELS=openrouter:nvidia/nemotron-3.5-lightning:free:20
SYNTH_TEXT_MODELS=
# Chave do OpenRouter (https://openrouter.ai/keys). Nunca é registrada em log.
OPENROUTER_API_KEY=
# Seed opcional do sorteio (reprodutibilidade).
SYNTH_SEED=
# Minutos fora do rodízio após 429/503 repetidos (estado em <KE_HOME>/.cache/model_health.json).
SYNTH_COOLDOWN_MIN=10
# Teto de gasto (US$) por execução com modelos PAGOS do OpenRouter (id sem ':free'),
# somando usage.cost. Ao atingir o teto, os modelos pagos são pulados (log). 0 = nunca usar pagos.
SYNTH_MAX_COST_USD=1.00
# Tentativas por modelo antes de passar ao próximo, e backoff base em segundos.
SYNTH_RETRIES=2
SYNTH_BACKOFF_S=3

# ------------------------------------------------------------------------------
# 4. Configurações de Transcrição de Áudio (faster-whisper)
# ------------------------------------------------------------------------------
# Precedência de cada valor: opção da CLI > esta variável > padrão automático.
# Valores inválidos interrompem a execução com erro claro.
#
# Modelo: tiny, base, small, medium, large-v3 (ou turbo, distil-large-v3...).
# Vazio = automático: large-v3 com GPU, small em CPU. Em CPU, use "medium" para mais
# fidelidade (2 a 3x mais lento que o small). O large-v3 em CPU é lento demais para aulas longas.
# (O nome antigo WHISPER_MODEL ainda é aceito, com aviso de depreciação.)
WHISPER_MODEL_SIZE=

# Dispositivo: auto (cuda se houver GPU, senão cpu), cpu ou cuda
WHISPER_DEVICE=auto

# Tipo de computação: auto (float16 na GPU, int8 na CPU), int8, float16, float32...
# float16 em CPU não é suportado: cai para int8 com aviso.
WHISPER_COMPUTE_TYPE=auto

# Idioma do áudio: vazio/auto = detecção pelo Whisper; ou pt, en, es...
# Precedência: --language > WHISPER_LANGUAGE > course.yaml > auto. A nota sai sempre em pt-BR.
WHISPER_LANGUAGE=

# ------------------------------------------------------------------------------
# 4b. PDF → nota (LRT-06)
# ------------------------------------------------------------------------------
# Máximo de imagens do PDF salvas em materiais/figuras/ e enviadas ao LLM multimodal
PDF_MAX_IMAGES=8
# PDFs maiores que isto (caracteres) são sintetizados em partes + síntese final
PDF_PART_CHARS=60000

# ------------------------------------------------------------------------------
# 4b. PDF → nota (LRT-06)
# ------------------------------------------------------------------------------
# Máximo de imagens do PDF salvas em materiais/figuras/ e enviadas ao LLM multimodal
PDF_MAX_IMAGES=8
# PDFs maiores que isto (caracteres) são sintetizados em partes + síntese final
PDF_PART_CHARS=60000

# ------------------------------------------------------------------------------
# 5. Métricas de Processamento
# ------------------------------------------------------------------------------
# Diretório de estado do extractor (logs/ e .cache/). Padrão: a pasta mais próxima com
# course.yaml subindo a partir do diretório atual (a raiz do repo do curso); sem course.yaml,
# o próprio diretório atual. Nunca dentro do pacote instalado.
# KE_HOME=
# CSV com início/fim/duração de cada atividade (padrão: <KE_HOME>/logs/pipeline-metrics.csv)
# METRICS_LOG=logs/pipeline-metrics.csv
